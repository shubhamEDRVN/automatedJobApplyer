# ═══════════════════════════════════════════════════════════════════
#  Automated Internship Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# ── AI Providers (add as many as you can for maximum uptime) ──────

# Gemini (Free: 15 RPM, 1500 RPD per key per model)
# Get keys from: https://aistudio.google.com/apikey
# TIP: Create multiple Google Cloud projects for multiple free keys!
GEMINI_API_KEY=your_key_here
GEMINI_API_KEY_2=your_second_key_here
GEMINI_API_KEY_3=your_third_key_here

# Groq (Free: 30 RPM, 14400 RPD — very generous!)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# OpenRouter (Free models available)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Job Scrapers ──────────────────────────────────────────────────

# Adzuna (Free: 250 calls/month)
# Get keys from: https://developer.adzuna.com/
ADZUNA_APP_ID=your_id
ADZUNA_APP_KEY=your_key

# ── Email (HTTPS API — bypasses SMTP bans) ────────────────────────

# Brevo (Free: 300 emails/day)
# Get key from: https://www.brevo.com/
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=your_verified_email@gmail.com
